{
    "name": "pjadanowski/scramble-extras",
    "description": "Spatie Laravel Data + Query Builder integration for dedoc/scramble. A free, open replacement for scramble-pro covering output/input Data schemas, all Spatie validation attributes, query-builder filters/sorts/includes, jsonPaginate, and persistent schema caching.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "scramble",
        "openapi",
        "spatie",
        "laravel-data",
        "laravel-query-builder",
        "documentation"
    ],
    "authors": [
        {
            "name": "Paweł Jadanowski",
            "email": "pjadanowski@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "dedoc/scramble": "^0.13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "nikic/php-parser": "^4.0 || ^5.0",
        "spatie/laravel-data": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.4",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "spatie/laravel-query-builder": "^6.0"
    },
    "suggest": {
        "spatie/laravel-query-builder": "Required to document `allowedFilters/Sorts/Includes/Fields`, `defaultSort`, and exact-enum filter detection."
    },
    "autoload": {
        "psr-4": {
            "PawelJadanowski\\ScrambleExtras\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PawelJadanowski\\ScrambleExtras\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "PawelJadanowski\\ScrambleExtras\\ScrambleExtrasServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
